# === HJU WebSight Monitor — env placeholders (fill on PC / server34 only) ===
# NEVER commit real secrets. Copy to .env or server systemd/pm2 env.

# --- App ---
PORT=3040
WEBSIGHT_BASE_URL=http://127.0.0.1:3040
# Optional simple admin gate for MVP API (set a long random token on server)
WEBSIGHT_ADMIN_TOKEN=

# Auth (strategy B magic-link). Dev session when SMTP unset / WEBSIGHT_DEV_AUTH=true
WEBSIGHT_DEV_AUTH=true
# WEBSIGHT_SMTP_URL=

# --- ToS-safe (assumption A1) ---
TOS_MODE=derived_meta
SNAPSHOT_TTL_DAYS=21
# Keep false until campus/Naver clearance for long-term daily numbers
AGGREGATE_KEEP=false

# --- PostgreSQL (candidate A or B — DBA provides URL) ---
# Prefer schema websight on either academic or IR instance
WEBSIGHT_DATABASE_URL=postgresql://websight_app:CHANGE_ME@127.0.0.1:5432/academic
DB_SCHEMA=websight

# --- Naver Search API (campus-issued) ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Kakao Daum Search (campus-issued REST key) ---
KAKAO_REST_API_KEY=

# --- Platforms (admin checkboxes → settings; comma-separated ids) ---
# Active defaults: naver_web,daum_web,youtube
# Conditional: instagram (hashtag), x (paid). Not recommended: tiktok,facebook
# Only checked platforms are collect targets. No auto-post.
ENABLED_PLATFORMS=naver_web,daum_web,youtube

# --- Google Custom Search JSON / PSE (COLLECTION DEFERRED) ---
# Periodic Google Top100 needs API Key + Search Engine ID (cx).
# New customer signup closed (P0); check campus EXISTING keys only.
# Do NOT set GOOGLE_ENABLED=true in P1 even if keys exist.
GOOGLE_ENABLED=false
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
