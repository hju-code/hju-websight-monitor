# Copy to .env locally or configure equivalent values in Vercel/server secret storage.
# No actual credentials belong in Git.
WEBSIGHT_DATABASE_URL=
DB_SCHEMA=websight
WEBSIGHT_ADMIN_EMAIL=
WEBSIGHT_INITIAL_ADMIN_PASSWORD=
# Server-side only. Set a real key in the deployment environment, never in Git.
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_API_LEGACY=false
KAKAO_REST_API_KEY=
CRON_SECRET=
ENABLED_PLATFORMS=naver_web
TOS_MODE=derived_meta
SNAPSHOT_TTL_DAYS=21
AGGREGATE_KEEP=false
GOOGLE_ENABLED=false
