{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "env": {
    "TOS_MODE": "derived_meta",
    "SNAPSHOT_TTL_DAYS": "21",
    "AGGREGATE_KEEP": "false",
    "GOOGLE_ENABLED": "false",
    "ENABLED_PLATFORMS": "naver_web"
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "15 21 * * *"
    }
  ]
}
